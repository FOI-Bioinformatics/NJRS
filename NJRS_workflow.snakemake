    output:
        os.path.join(config['output_dir'],'groups/{group}/CANSNP_candidates_fitAmbiguous/tree_after.pdf')
    conda:
        "envs/conda.yaml"
    params:
        group_dir=os.path.join(config['output_dir'],'groups/{group}/'),
        ref_path=config['ref_fa_path']
    shell:
        """
        scripts/discovery_msa_stable_add_ambiguous.py \
        --tree {params.group_dir}/CANSNP_candidates/tree_raw.nwk \
        --congruent_snp_file {params.group_dir}/CANSNP_candidates/SNPs.tsv \
        --msa_raw {params.group_dir}/MSA/msa_slim.fasta \
        --msa_raw_coords {params.group_dir}/MSA/msa_slim_coords.list \
        --ambig_snp_coords {params.group_dir}/MSA_stable/coords_not_output_to_msa.list \
        --output {params.group_dir}/CANSNP_candidates_fitAmbiguous/ \
        --ref {params.ref_path}
        """

rule msa_add_ref_info:
    # output for this rule is required in "stablePipe_summary"
    input:
        os.path.join(config['output_dir'],'groups/{group}/MSA/msa_slim.fasta')
    output:
        os.path.join(config['output_dir'],'groups/{group}/MSA/msa_slim_coords_refinfo.tsv')
    conda:
        "envs/conda.yaml"
    params:
        group_dir=os.path.join(config['output_dir'],'groups/{group}/'),
        ref_path=config['ref_fa_path'],
        ref_gff_path=config['ref_gff_path']
    shell:
        """
        scripts/discovery_output_ref_nucl_and_annotation.py \
        --reference {params.ref_path} \
        --gff {params.ref_gff_path} \
        --input {params.group_dir}/MSA/msa_slim_coords.list \
        --output {params.group_dir}/MSA/msa_slim_coords_refinfo.tsv \
        --split_input_by_comma
        """

rule stablePipe_summary:
    input:
        # require files from previous scripts. The script in this rule will use multiple files generated by the previous ones (not only the ones listed below).
        os.path.join(config['output_dir'],'groups/{group}/MSA/msa_slim.fasta'),
        os.path.join(config['output_dir'],'groups/{group}/MSA/msa_slim_coords_refinfo.tsv'),
        os.path.join(config['output_dir'],'groups/{group}/MSA_stable/msa_stable.fasta'),
        os.path.join(config['output_dir'],'groups/{group}/CANSNP_candidates/SNPs.tsv'),
        os.path.join(config['output_dir'],'groups/{group}/CANSNP_candidates_fitAmbiguous/tree_after.pdf')
    output:
        os.path.join(config['output_dir'],'groups/{group}/summary_stablePipe.tsv')
    conda:
        "envs/conda.yaml"
    params:
        group_dir=os.path.join(config['output_dir'],'groups/{group}/'),
        ref_path=config['ref_fa_path'],
        global_basecounts_dir=os.path.join(config['output_dir'],'basecounts')
    shell:
        """
        scripts/discovery_msa_stable_summary.py \
        --input {params.group_dir} \
        --basecounts {params.global_basecounts_dir} \
        --reference {params.ref_path} \
        --output {params.group_dir}/summary_stablePipe.tsv
        """

rule mark_noncongruent_snps:
    input:
        # require files from previous scripts. The script in this rule will use multiple files generated by the previous ones (not only the ones listed below).
        os.path.join(config['output_dir'],'groups/{group}/MSA/msa_slim.fasta'),
        os.path.join(config['output_dir'],'groups/{group}/CANSNP_candidates_fitAmbiguous/tree_after.pdf'),
        os.path.join(config['output_dir'],'groups/{group}/summary_stablePipe.tsv')
    output:
        directory(os.path.join(config['output_dir'],'groups/{group}/mark_noncongruent_snps'))
    conda:
        "envs/conda.yaml"
    params:
        group_dir=os.path.join(config['output_dir'],'groups/{group}/'),
    shell:
        """
        # remove previously generated plots, if they exist. Run might have changed since previous run and so re-generate plots
        rm -rf {params.group_dir}/mark_noncongruent_snps
        
        scripts/mark_noncongruent_snps.py \
        --tree {params.group_dir}/CANSNP_candidates_fitAmbiguous/tree_nodifyed_raw.nwk \
        --msa_slim {params.group_dir}/MSA/msa_slim.fasta \
        --msa_slim_coords {params.group_dir}/MSA/msa_slim_coords.list \
        --snp_summary {params.group_dir}/summary_stablePipe.tsv \
        --output {params.group_dir}/mark_noncongruent_snps
        """

rule prepare_progressivemauve:
    input:
        os.path.join(config['fasta_dir'],'{dataset_fasta}.fasta')
    output:
        os.path.join(config['output_dir'],'fasta/softlinks/{dataset_fasta}.fasta')
    params:
        outdir=os.path.join(config['output_dir'],'fasta/softlinks')
    shell:
        """
        mkdir -p {params.outdir}
        ln -s "$(realpath {input})" {output}
        """

rule run_progressivemauve:
    input:
        os.path.join(config['output_dir'],'fasta/softlinks/{dataset_fasta}.fasta')
    output:
        os.path.join(config['output_dir'],'fasta/xmfa/{dataset_fasta}.xmfa')
    conda:
        "envs/conda.yaml"
    params:
        ref_path=config['ref_fa_path'],
        outdir=os.path.join(config['output_dir'],'fasta/xmfa')
    shell:
        """
        mkdir -p {params.outdir}
        progressiveMauve --output {output} {params.ref_path} {input}
        """

rule run_x2fa:
    input:
        os.path.join(config['output_dir'],'fasta/xmfa/{dataset_fasta}.xmfa')
    output:
        os.path.join(config['output_dir'],'fasta/x2fa/{dataset_fasta}.pairwise.fasta')
    params:
        ref_path=config['ref_fa_path'],
        outdir=os.path.join(config['output_dir'],'fasta/x2fa')
    shell:
        """
        mkdir -p {params.outdir}
        scripts/x2fa.py {input} {params.ref_path} 0 {output}
        """

rule pmauve_x2fa_msa_workflow:
    input:
        expand(os.path.join(config['output_dir'],'fasta/x2fa/{dataset_fasta}.pairwise.fasta'),dataset_fasta=fasta_datasets)
    output:
        os.path.join(config['output_dir'],'fasta/fastas_snpmsa.fasta')
    run:
        print('[pmauve_x2fa_msa_workflow] Concatenating pairwise alignment fasta files to MSA-fasta')
        ref_written = False
        ref_name = None
        write_line = True
        with open(output[0],'w') as nf:
            for file_ in input:
                with open(file_,'r') as f:
                    for line_enum,line in enumerate(f):
                        # Check if header-line. Then remove path to file and keep only the file (genome) name.
                        if line[0] == '>':
                            line = '>' + os.path.splitext(line.split('/')[-1])[0]+'\n' # keeps only the file name
                        #/
                        # Check if toggle writing (the "ref" exist in all single-alignment-fastas, but we just want one entry for the MSA-fasta)
                        if line[0] == '>':
                            if line_enum == 0:
                                if ref_written: # if ref was written, dont write more ref-lines
                                    write_line = False
                                else: # Write ref once
                                    write_line = True
                                    ref_written = True
                            else:
                                write_line = True
                        #/
                        
                        # write
                        if write_line:
                            nf.write(line)
                        #/
        print('[pmauve_x2fa_msa_workflow] Done!')


rule summarize_groups:
    input:
        expand(os.path.join(config['output_dir'],'groups/{group}/summary_stablePipe.tsv'),group=groups_samples)
    output:
        os.path.join(config['output_dir'],'groups_summarized.tsv')
    params:
        groups_workdir=os.path.join(config['output_dir'],'groups'),
        args=params_to_args(config['summarize_groups_args'])
    conda:
        "envs/conda.yaml"
    shell:
        """
        scripts/discovery_msa_stable_summarize_groups.py \
        --input {params.groups_workdir} \
        --output {output} \
        {params.args}
        """

rule addFastaDatasets_to_summary:
    input:
        os.path.join(config['output_dir'],'groups_summarized.tsv'),
        os.path.join(config['output_dir'],'fasta/fastas_snpmsa.fasta')
    output:
        os.path.join(config['output_dir'],'groups_summarized_addFastaDatasets.tsv')
    params:
        msa_path=os.path.join(config['output_dir'],'fasta/fastas_snpmsa.fasta'),
        table_path=config['fasta_group_table'],
        summary_path=os.path.join(config['output_dir'],'groups_summarized.tsv'),
        ref_name=os.path.basename(config['ref_fa_path']).replace('.fasta','').replace('.fna','').replace('.fa','').replace('.gz','')
    conda:
        "envs/conda.yaml"
    shell:
        """
        scripts/discovery_msa_stable_fitFastaSNPsToSummary.py --msa {params.msa_path} --table {params.table_path} --summary {params.summary_path} --msa_ref_name {params.ref_name} --output {output}
        """
