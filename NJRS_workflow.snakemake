    output:
        os.path.join(config['output_dir'],'groups/{group}/CANSNP_candidates/SNPs.tsv')
    conda:
        "envs/conda.yaml"
    resources:
        max_heavy_memory_slots=1
    params:
        group_dir=os.path.join(config['output_dir'],'groups/{group}/'),
        ref_path=config['ref_fa_path'],
        args=params_to_args(config['find_congruent_snps_from_msa_args'])
    shell:
        """
        python scripts/find_congruent_snps_from_msa.py \
            --input {params.group_dir}/MSA_stable/msa_stable.fasta \
            --coordinates {params.group_dir}/MSA_stable/msa_stable_coords.list \
            --genome {params.ref_path} \
            --output {params.group_dir}/CANSNP_candidates \
            {params.args}
        """

rule discovery_msa_add_ambiguous:
