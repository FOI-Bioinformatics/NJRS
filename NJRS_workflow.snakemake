import os
from glob import glob
import csv

## Parse config file
configfile: "NJRS_config.yaml"

def params_to_args(params): # helper-function to return whatever arguments were supplied in the config (user may want to comment-out certain parameters)
    args = []
    for k, v in params.items():
        if isinstance(v, bool):
            if v:
                args.append(f"--{k}")
        else:
            args.append(f"--{k} {v}")
    return " ".join(args)
##/

## Parse sample groups (expected structure: columns with [1] sample name, [2] sample group)
samples_groups = {}
groups_samples = {}
for file_ in os.listdir(config['sample_groups_dir']):
    group = os.path.splitext(file_)[0]
    with open(config['sample_groups_dir']+'/'+file_) as f:
        for row in f:
            row=row.strip('\n')
            if not row or row[0] == '#': continue # skip empty rows or commentary rows
            samples_groups[row] = group
            
            if not group in groups_samples:         groups_samples[group] = []
            groups_samples[group].append(row)

sample_names = list(samples_groups.keys())
sample_groups = list(groups_samples.keys())
for k,v in samples_groups.items():
    print(f'{k}\t{v}')
print(f'Number of samples: {len(sample_names)}')
print(f'Number of groups: {len(sample_groups)}')
##/

## Parse background datasets
background_datasets = []
for file_ in os.listdir(config['bam_dir']):
    if file_.endswith('.bam'):
        file_ = file_.replace('.bam','')
        if not file_ in sample_names:
            background_datasets.append(file_)
print(f'Number of "background" datasets: {len(background_datasets)}')
##/

## Parse fasta datasets
fasta_datasets = []
for file_ in os.listdir(config['fasta_dir']):
    if file_.endswith('.fasta'):
        file_ = file_.replace('.fasta','')
        fasta_datasets.append(file_)
print(f'Number of fasta datasets: {len(fasta_datasets)}')
##/

# Trigger rule for workflow
if config['make_noncongruent_snp_plots']:
    rule all:
        input:
            expand(os.path.join(config['output_dir'],'groups/{group}/mark_noncongruent_snps'), group=groups_samples)
else:
    rule all:
        input:
            #expand(os.path.join(config['output_dir'],'groups/{group}/checkpoint.group_init_done'), group=groups_samples) ## Test initdirs
            #expand(os.path.join(config['output_dir'],'groups/{group}/MSA/msa_slim.fasta'), group=groups_samples) ## Test MSA
            #expand(os.path.join(config['output_dir'],'groups/{group}/MSA_stable/msa_stable.fasta'), group=groups_samples) ## Test MSA_stable
            #expand(os.path.join(config['output_dir'],'groups/{group}/CANSNP_candidates/SNPs.tsv'), group=groups_samples) ## Test find_congruent_snps_from_msa
            #expand(os.path.join(config['output_dir'],'groups/{group}/CANSNP_candidates_fitAmbiguous/tree_after.pdf'), group=groups_samples) ## Test add_ambig_snps
            #expand(os.path.join(config['output_dir'],'groups/{group}/summary_stablePipe.tsv'), group=groups_samples), ## Test summary
            # trigger endpoint file
            expand(os.path.join(config['output_dir'],'basecounts/{dataset}_bg.basecounts.gz'), dataset=background_datasets), # trigger basecounts generate of background datasets
            os.path.join(config['output_dir'],'groups_summarized.tsv'), # aggregate group summaries to overall summary
            os.path.join(config['output_dir'],'groups_summarized_addFastaDatasets.tsv') # include fasta datasets to overall summary
#/

### rules
rule generate_basecounts:
    input:
        os.path.join(config['bam_dir'],'{sample}.bam')
    output:
        os.path.join(config['output_dir'],'basecounts/{sample}.basecounts.gz')
    conda:
        "envs/conda.yaml"
    params:
        ref_path=config['ref_fa_path']
    shell:
        """
        python scripts/pileup.py --input {input} --output {output} --genome {params.ref_path}
        """

rule generate_basecounts_background:
    input:
        os.path.join(config['bam_dir'],'{dataset}.bam')
    output:
        os.path.join(config['output_dir'],'basecounts/{dataset}_bg.basecounts.gz')
    conda:
        "envs/conda.yaml"
    params:
        ref_path=config['ref_fa_path']
    shell:
        """
        python scripts/pileup.py --input {input} --output {output} --genome {params.ref_path}
        """

rule init_group_directory:
    input:
        lambda wildcards: expand(os.path.join(config['output_dir'],'basecounts/{sample}.basecounts.gz'), sample=groups_samples[wildcards.group])
    params:
        basecounts_dir=os.path.abspath(os.path.join(config['output_dir'],'basecounts/')),
        group_dir=os.path.join(config['output_dir'],'groups/{group}/'),
        samples=lambda wildcards: groups_samples[wildcards.group]
    output:
        os.path.join(config['output_dir'],'groups/{group}/checkpoint.group_init_done')
    shell:
        """
        mkdir -p {params.group_dir}
        mkdir -p {params.group_dir}/basecounts
        for sample in {params.samples}; do
            ln -sf {params.basecounts_dir}/${{sample}}.basecounts.gz {params.group_dir}/basecounts/${{sample}}.basecounts.gz
        done
        touch {output}
        """

rule generate_MSA_from_basecounts:
    input:
        os.path.join(config['output_dir'],'groups/{group}/checkpoint.group_init_done')
    output:
        os.path.join(config['output_dir'],'groups/{group}/MSA/msa_slim.fasta')
    conda:
        "envs/conda.yaml"
    resources:
        max_heavy_memory_slots=1
    params:
        group_dir=os.path.join(config['output_dir'],'groups/{group}/'),
        ref_path=config['ref_fa_path'],
        args=params_to_args(config['generate_MSA_from_basecounts_args'])
    shell:
        """
        python scripts/fixed_and_lowfreq_snps.py \
            --input {params.group_dir}/basecounts \
            --output {params.group_dir}/MSA \
            --genome {params.ref_path} \
            {params.args}
        """

rule filter_stable_MSA_positions:
    input:
        os.path.join(config['output_dir'],'groups/{group}/MSA/msa_slim.fasta')
    output:
        os.path.join(config['output_dir'],'groups/{group}/MSA_stable/msa_stable.fasta')
    conda:
        "envs/conda.yaml"
    params:
        group_dir=os.path.join(config['output_dir'],'groups/{group}/'),
        ref_path=config['ref_fa_path'],
        args=params_to_args(config['filter_stable_MSA_positions_args'])
    shell:
        """
        python scripts/msa_filter_stable.py \
            --basecounts_dir {params.group_dir}/basecounts \
            --msa_slim {params.group_dir}/MSA/msa_slim.fasta \
            --msa_slim_coords {params.group_dir}/MSA/msa_slim_coords.list \
            --ref {params.ref_path} \
            --outdir {params.group_dir}/MSA_stable \
